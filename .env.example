# Copy this file to .env.local and fill in your real values from Supabase.
# Both keys are SAFE to expose in a browser bundle (the anon key is public by design).
# Real protection comes from RLS policies in the database.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
